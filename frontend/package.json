{
	"name": "albums2-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen:protoc": "protoc --ts_proto_out=./src/lib/server/grpc/proto --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,useExactTypes=false  -I /workspaces/grpc mlservice.proto"
	},
	"devDependencies": {
		"@better-auth/mongo-adapter": "^1.7.6",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.2",
		"@types/hammerjs": "^2.0.46",
		"@types/mime-types": "^3.0.1",
		"@types/mongodb": "^4.0.7",
		"@types/node": "^26",
		"auth": "^1.6.23",
		"daisyui": "^5.7.46",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"mongodb": "^7.7.0",
		"prettier": "^3.8.3",
		"prettier-plugin-jsdoc": "^1.8.1",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"sveltekit-openapi-generator": "^0.1.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.12",
		"@better-auth/oauth-provider": "^1.7.6",
		"@imgproxy/imgproxy-node": "^1.1.0",
		"@mdi/js": "^7.4.47",
		"@videojs/html": "^10.1.0",
		"bson": "^7.3.3",
		"hammerjs": "^2.0.8",
		"mime-types": "^3.0.2",
		"mongoose": "^9.10.3",
		"mongoose-aggregate-paginate-v2": "^1.1.5",
		"nice-grpc": "^2.1.17",
		"nice-grpc-common": "^2.0.4",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"redis": "^6.3.0",
		"swagger-ui-dist": "^5.33.1",
		"ts-proto": "^2.18.0"
	}
}
