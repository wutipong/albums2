{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wutipong/albums2/schema/common.json",
  "$defs": {
    "ObjectID": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "tsType": "import('mongodb').ObjectId",
      "goJSONSchema": {
        "type": "bson.ObjectID",
        "imports": ["go.mongodb.org/mongo-driver/v2/bson"]
      }
    }
  }
}
