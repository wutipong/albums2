// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/marcosgomesneto/bun-devcontainers/tree/main/src/bun-postgresql
{
  "name": "github/wutipong/albums",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/",
  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/common-utils:": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/go:": {
      "golangciLintVersion": "2.11.4",
      "version": "latest"
    },
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "latest"
    },
    "ghcr.io/robbert229/devcontainer-features/postgresql-client:1": {
      "version": 18
    },
    "ghcr.io/devcontainers-extra/features/act:1": {},
    "ghcr.io/devcontainers-extra/features/protoc:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {},
    "ghcr.io/azutake/devcontainer-features/go-packages-install:0": {
      "PACKAGES": "google.golang.org/protobuf/cmd/protoc-gen-go@latest,google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest,github.com/minio/mc@latest,github.com/cshum/vipsgen/cmd/vipsgen@latest"
    },
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "caddy,libvips-dev,libvpx12,libopus0,ffmpeg,libvips-tools"
    }
  },
  "mounts": [
    "source=./mc,target=/home/vscode/.mc,type=bind,consistency=cached",
    "source=./bin,target=/home/vscode/bin,type=bind,consistency=cached"
  ],
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // This can be used to network with other containers or with the host.
  "forwardPorts": [
    3000,
    5173,
    "dex:5556",
    "garage:3900",
    "garage:3901",
    "garage:3902",
    "imgproxy:8080",
    "mongo-express:8081",
    "redis-insight:5540"
  ],
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "esbenp.prettier-vscode",
        "DrBlury.protobuf-vsc"
      ],
      "settings": {
        "python.terminal.activateEnvironment": false
      }
    }
  },
  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": ".devcontainer/post-create.sh",

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"

  "postStartCommand": "caddy start --config .devcontainer/Caddyfile"
}
